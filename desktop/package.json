{
  "name": "castle-crm-desktop",
  "productName": "Castle CRM",
  "version": "0.1.0",
  "private": true,
  "description": "Application de bureau de Castle : le même CRM que la version en ligne.",
  "author": "Castle",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node test-shell.mjs",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "tn.castle.crm",
    "productName": "Castle CRM",
    "artifactName": "Castle-CRM-Setup-${version}.${ext}",
    "npmRebuild": false,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.cjs", "offline.html"],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Castle CRM",
      "installerLanguages": ["fr_FR"],
      "language": "1036"
    }
  }
}
