{
  "name": "castle-crm-desktop",
  "productName": "Dopamine Fitness",
  "version": "0.4.0",
  "private": true,
  "description": "Application de bureau de Dopamine Fitness : le même CRM que la version en ligne.",
  "author": "Dopamine Fitness",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node test-shell.mjs",
    "test:offline": "node test-offline.mjs",
    "build:server": "node build-server.mjs",
    "dist": "node build-server.mjs && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "tn.castle.crm",
    "productName": "Dopamine Fitness",
    "artifactName": "Dopamine-Fitness-Setup-${version}.${ext}",
    "npmRebuild": false,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.cjs", "offline.html", "splash.html", "server-entry.cjs"],
    "afterPack": "./after-pack.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dopamine Fitness",
      "installerLanguages": ["fr_FR"],
      "language": "1036"
    }
  }
}
